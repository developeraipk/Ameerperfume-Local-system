{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ameer Perfumes ERP",
  "version": "4.3.9",
  "identifier": "com.ameerperfumes.pos",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Ameer Perfumes ERP — Luxury Perfumery Management System",
        "width": 1366,
        "height": 850,
        "minWidth": 1024,
        "minHeight": 720,
        "fullscreen": false,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
